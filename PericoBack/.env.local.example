# Solo desarrollo local; coincide con compose.yaml.
NODE_ENV=development
PORT=3000
# Evita que una DATABASE_URL de .env seleccione accidentalmente una base remota.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=perico_db
DB_USER=taxi_local
DB_PASSWORD=taxi_local_password
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
DB_POOL_MAX=5
JWT_SECRET=solo-desarrollo-local-cambiar-en-produccion-12345
FRONTEND_URL=http://localhost:4200
GOOGLE_CLIENT_ID=
DB_INTEGRATION_URL=postgresql://taxi_local:taxi_local_password@127.0.0.1:55439/taxi_integration
