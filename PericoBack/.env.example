NODE_ENV=development
PORT=3000
# Local: crear previamente una base vacia perico_db con el propietario indicado.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=perico_db
DB_USER=postgres
DB_PASSWORD=
# Remoto: usar Session pooler de Supabase (puerto 5432); codificar la password en la URL.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# DB_SSL=true
# Certificado CA descargado del panel de Supabase; se aceptan saltos de linea o \n.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Alternativa local / Secret File de Render: DB_SSL_CA_FILE=/ruta/prod-supabase.cer
DB_POOL_MAX=5
JWT_SECRET=
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:4200
